# SAANS SAATHI AI - environment template
#
# Copy this file to:
#   backend/.env        for the FastAPI service
#   frontend/.env.local for the Next.js app
#
# Never commit real credentials. Values below are local placeholders only.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=SAANS SAATHI API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Required in production. Optional in development (see README "Database").
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/saans
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Optional external integrations. The API starts without them and reports
# them as "not_configured" on the health endpoint.
GEMINI_API_KEY=
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com/v1
AIR_FORECAST_TTL_SECONDS=10800

# OpenAQ v3 ground-station observations (optional; coverage is incomplete).
OPENAQ_API_BASE_URL=https://api.openaq.org
OPENAQ_API_KEY=
OPENAQ_DAILY_CALL_BUDGET=2000
OPENAQ_STATION_RADIUS_KM=25
OPENAQ_STATIONS_PER_PAGE=20

# Open-Meteo geocoding for city search.
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1
GEOCODING_CACHE_TTL_SECONDS=86400
LOCATION_SEARCH_MAX_RESULTS=10

# Per-session family recommendation runs.
FAMILY_GENERATIONS_PER_HOUR=30

# CPCB ground-station access remains disabled until an official, verified
# data-access mechanism is available. Do not point these at an unverified URL.
CPCB_ENABLED=false
CPCB_API_BASE_URL=
CPCB_API_KEY=

# Comma-separated origins allowed by CORS / trusted host checks.
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
