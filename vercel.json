{
  "version": 2,
  "builds": [
    {
      "src": "frontend/next.config.ts",
      "use": "@vercel/next-build"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/.next/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py?/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": "https://saans-saathi-api.vercel.app"
  }
}